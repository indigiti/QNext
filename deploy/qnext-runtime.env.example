# Non-secret QNext runtime settings.
QNEXT_HTTP_ADDR=127.0.0.1:18080
QNEXT_STORAGE_ROOT=/home/ACCOUNT/private_html/qnext/storage
QNEXT_MARKET_CONFIG=/home/ACCOUNT/private_html/qnext/config/q1-market.json
# QNEXT_RESILIENCE_CONFIG=/home/ACCOUNT/private_html/qnext/config/q3-resilience.json
QNEXT_RAW_CAPTURE=1
QNEXT_REQUIRE_LIVE_READY=1

# Research/Data Collector lane. NIFTY remains the default isolated research market.
QNEXT_DATA_COLLECTOR_MARKET=NIFTY
QNEXT_DATA_COLLECTOR_WING_STRIKES=20
QNEXT_DATA_COLLECTOR_FULL_WING_STRIKES=5
QNEXT_DATA_COLLECTOR_RAW_CAPTURE=0
QNEXT_SYN_PLUS_INSTRUMENT_ID=QNEXT:NIFTY-SYN+
QNEXT_SYN_PLUS_VERSION=nifty-syn-plus-v1
