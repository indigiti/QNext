#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -z "${QNEXT_PRIVATE_ROOT:-}" ]]; then
  if [[ -f "$SCRIPT_DIR/../bin/qnext-market-core.current" || -f "$SCRIPT_DIR/../bin/qnext-market-core" ]] || compgen -G "$SCRIPT_DIR/../bin/qnext-market-core-*" >/dev/null; then
    QNEXT_PRIVATE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
  else
    QNEXT_PRIVATE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
  fi
fi

PRIVATE_ROOT="${QNEXT_PRIVATE_ROOT%/}"
CURRENT_PRIVATE=""

if [[ -L "$PRIVATE_ROOT/current" ]]; then
  current_target="$(readlink -f "$PRIVATE_ROOT/current" 2>/dev/null || true)"
  if [[ -n "$current_target" && -d "$current_target/private" ]]; then
    CURRENT_PRIVATE="$current_target/private"
  fi
fi

PAYLOAD_PRIVATE="$PRIVATE_ROOT"
if [[ -n "$CURRENT_PRIVATE" ]]; then
  PAYLOAD_PRIVATE="$CURRENT_PRIVATE"
elif [[ -f "$PRIVATE_ROOT/private/bin/qnext-market-core.current" || -f "$PRIVATE_ROOT/private/bin/qnext-market-core" ]] || compgen -G "$PRIVATE_ROOT/private/bin/qnext-market-core-*" >/dev/null; then
  PAYLOAD_PRIVATE="$PRIVATE_ROOT/private"
fi

resolve_binary() {
  local pointer candidate
  pointer="$PAYLOAD_PRIVATE/bin/qnext-market-core.current"
  if [[ -s "$pointer" ]]; then
    candidate="$(tr -d '\r\n' < "$pointer")"
    if [[ "$candidate" =~ ^qnext-market-core-[A-Za-z0-9._-]+$ && -f "$PAYLOAD_PRIVATE/bin/$candidate" ]]; then
      printf '%s\n' "$PAYLOAD_PRIVATE/bin/$candidate"
      return 0
    fi
  fi

  if [[ -f "$PAYLOAD_PRIVATE/bin/qnext-market-core" ]]; then
    printf '%s\n' "$PAYLOAD_PRIVATE/bin/qnext-market-core"
    return 0
  fi

  candidate="$(ls -1t "$PAYLOAD_PRIVATE"/bin/qnext-market-core-* 2>/dev/null | head -n 1 || true)"
  if [[ -n "$candidate" && -f "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

resolve_collector_binary() {
  local pointer candidate
  pointer="$PAYLOAD_PRIVATE/bin/qnext-data-collector.current"
  if [[ -s "$pointer" ]]; then
    candidate="$(tr -d '\r\n' < "$pointer")"
    if [[ "$candidate" =~ ^qnext-data-collector-[A-Za-z0-9._-]+$ && -f "$PAYLOAD_PRIVATE/bin/$candidate" ]]; then
      printf '%s\n' "$PAYLOAD_PRIVATE/bin/$candidate"
      return 0
    fi
  fi

  if [[ -f "$PAYLOAD_PRIVATE/bin/qnext-data-collector" ]]; then
    printf '%s\n' "$PAYLOAD_PRIVATE/bin/qnext-data-collector"
    return 0
  fi

  candidate="$(ls -1t "$PAYLOAD_PRIVATE"/bin/qnext-data-collector-* 2>/dev/null | head -n 1 || true)"
  if [[ -n "$candidate" && -f "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

BINARY="$(resolve_binary || true)"
COLLECTOR_BINARY="$(resolve_collector_binary || true)"
PID_FILE="$PRIVATE_ROOT/run/market-core.pid"
COLLECTOR_PID_FILE="$PRIVATE_ROOT/run/data-collector.pid"
LOG_FILE="$PRIVATE_ROOT/logs/market-core.log"
COLLECTOR_LOG_FILE="$PRIVATE_ROOT/logs/data-collector.log"
CONFIG_FILE="$PRIVATE_ROOT/config/q1-market.json"
RESILIENCE_FILE="$PRIVATE_ROOT/config/q3-resilience.json"
SECRETS_FILE="$PRIVATE_ROOT/secrets/qnext.env"
CONTROL_REQUEST="$PRIVATE_ROOT/run/control-request"
DESIRED_STATE="$PRIVATE_ROOT/run/desired-state"
CRON_HEARTBEAT="$PRIVATE_ROOT/run/cron-heartbeat"
INTELLIGENCE_REQUEST="$PRIVATE_ROOT/run/intelligence-request.json"
INTELLIGENCE_RESULT="$PRIVATE_ROOT/run/intelligence-result.json"
INTELLIGENCE_LOG="$PRIVATE_ROOT/logs/intelligence.log"
INTELLIGENCE_LAB_REQUEST="$PRIVATE_ROOT/run/intelligence-lab-request.json"
INTELLIGENCE_LAB_RESULT="$PRIVATE_ROOT/run/intelligence-lab-result.json"
INTELLIGENCE_LAB_LOG="$PRIVATE_ROOT/logs/intelligence-lab.log"
INTELLIGENCE_LAB_SHADOW_INBOX="$PRIVATE_ROOT/run/intelligence-lab-shadow-inbox"
INTELLIGENCE_LAB_SHADOW_RESULT="$PRIVATE_ROOT/run/intelligence-lab-shadow-last.json"
INTELLIGENCE_LAB_PYTHON_HELPER="$PAYLOAD_PRIVATE/deploy/qnext-intelligence-lab-python"
LOCK_DIR="$PRIVATE_ROOT/run/supervisor.lock"
MARKET_URL="${QNEXT_MARKET_CORE_URL:-http://127.0.0.1:18080}"

mkdir -p "$PRIVATE_ROOT/run" "$PRIVATE_ROOT/logs" "$PRIVATE_ROOT/storage" "$PRIVATE_ROOT/config" "$PRIVATE_ROOT/secrets"

if [[ ! -s "$DESIRED_STATE" ]]; then
  printf 'stopped\n' > "$DESIRED_STATE"
fi

read_pid() {
  if [[ -s "$PID_FILE" ]]; then
    cat "$PID_FILE"
  fi
}

read_collector_pid() {
  if [[ -s "$COLLECTOR_PID_FILE" ]]; then
    cat "$COLLECTOR_PID_FILE"
  fi
}

find_existing_pid() {
  local proc pid exe
  for proc in /proc/[0-9]*; do
    [[ -e "$proc/exe" ]] || continue
    pid="${proc##*/}"
    [[ "$pid" != "$$" ]] || continue
    exe="$(readlink -f "$proc/exe" 2>/dev/null || true)"
    case "$exe" in
      "$PAYLOAD_PRIVATE/bin/qnext-market-core"|"$PAYLOAD_PRIVATE/bin/qnext-market-core-"*)
        printf '%s\n' "$pid"
        return 0
        ;;
    esac
  done
  return 1
}

find_existing_collector_pid() {
  local proc pid exe
  for proc in /proc/[0-9]*; do
    [[ -e "$proc/exe" ]] || continue
    pid="${proc##*/}"
    [[ "$pid" != "$$" ]] || continue
    exe="$(readlink -f "$proc/exe" 2>/dev/null || true)"
    case "$exe" in
      "$PAYLOAD_PRIVATE/bin/qnext-data-collector"|"$PAYLOAD_PRIVATE/bin/qnext-data-collector-"*)
        printf '%s\n' "$pid"
        return 0
        ;;
    esac
  done
  return 1
}

is_running() {
  local pid
  pid="$(read_pid || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi

  rm -f "$PID_FILE"
  pid="$(find_existing_pid || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    printf '%s\n' "$pid" > "$PID_FILE"
    return 0
  fi

  return 1
}

collector_running() {
  local pid
  pid="$(read_collector_pid || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi

  rm -f "$COLLECTOR_PID_FILE"
  pid="$(find_existing_collector_pid || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    printf '%s\n' "$pid" > "$COLLECTOR_PID_FILE"
    return 0
  fi

  return 1
}

runtime_binary_current() {
  local pid running_identity deployed_identity
  pid="$(read_pid || true)"
  [[ -n "$pid" ]] || return 1
  [[ -e "/proc/$pid/exe" ]] || return 1
  [[ -f "$BINARY" ]] || return 1

  running_identity="$(stat -Lc '%d:%i' "/proc/$pid/exe" 2>/dev/null || true)"
  deployed_identity="$(stat -Lc '%d:%i' "$BINARY" 2>/dev/null || true)"
  [[ -n "$running_identity" && "$running_identity" == "$deployed_identity" ]]
}

collector_binary_current() {
  local pid running_identity deployed_identity
  pid="$(read_collector_pid || true)"
  [[ -n "$pid" ]] || return 1
  [[ -e "/proc/$pid/exe" ]] || return 1
  [[ -f "$COLLECTOR_BINARY" ]] || return 1

  running_identity="$(stat -Lc '%d:%i' "/proc/$pid/exe" 2>/dev/null || true)"
  deployed_identity="$(stat -Lc '%d:%i' "$COLLECTOR_BINARY" 2>/dev/null || true)"
  [[ -n "$running_identity" && "$running_identity" == "$deployed_identity" ]]
}

acquire_lock() {
  local owner attempts=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    owner=""
    if [[ -s "$LOCK_DIR/pid" ]]; then
      owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    fi

    if [[ -z "$owner" ]] || ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      continue
    fi

    attempts=$((attempts + 1))
    if (( attempts >= 50 )); then
      echo "QNext supervisor is busy" >&2
      return 5
    fi
    sleep 0.1
  done

  printf '%s\n' "$$" > "$LOCK_DIR/pid"
  trap 'rm -rf "$LOCK_DIR" 2>/dev/null || true' EXIT INT TERM
}

status() {
  if is_running; then
    echo "active"
    return 0
  fi
  rm -f "$PID_FILE"
  echo "stopped"
  return 0
}

research_status() {
  if collector_running; then
    echo "active"
    return 0
  fi
  rm -f "$COLLECTOR_PID_FILE"
  echo "stopped"
  return 0
}

load_runtime_environment() {
  export QNEXT_HTTP_ADDR="127.0.0.1:18080"
  export QNEXT_STORAGE_ROOT="$PRIVATE_ROOT/storage"
  export QNEXT_RAW_CAPTURE="1"

  if [[ -r "$SECRETS_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$SECRETS_FILE"
    set +a
  fi

  export QNEXT_DATA_COLLECTOR_MARKET="${QNEXT_DATA_COLLECTOR_MARKET:-NIFTY}"
  export QNEXT_DATA_COLLECTOR_WING_STRIKES="${QNEXT_DATA_COLLECTOR_WING_STRIKES:-20}"
  export QNEXT_DATA_COLLECTOR_FULL_WING_STRIKES="${QNEXT_DATA_COLLECTOR_FULL_WING_STRIKES:-5}"
  export QNEXT_DATA_COLLECTOR_RAW_CAPTURE="${QNEXT_DATA_COLLECTOR_RAW_CAPTURE:-0}"
  export QNEXT_SYN_PLUS_INSTRUMENT_ID="${QNEXT_SYN_PLUS_INSTRUMENT_ID:-QNEXT:NIFTY-SYN+}"
  export QNEXT_SYN_PLUS_VERSION="${QNEXT_SYN_PLUS_VERSION:-nifty-syn-plus-v1}"

  unset QNEXT_MARKET_CONFIG QNEXT_RESILIENCE_CONFIG

  if [[ -s "$CONFIG_FILE" && -n "${UPSTOX_ACCESS_TOKEN:-}" ]]; then
    export QNEXT_MARKET_CONFIG="$CONFIG_FILE"
  fi

  if [[ -s "$RESILIENCE_FILE" && -n "${DHAN_CLIENT_ID:-}" && -n "${DHAN_ACCESS_TOKEN:-}" && -n "${QNEXT_MARKET_CONFIG:-}" ]]; then
    export QNEXT_RESILIENCE_CONFIG="$RESILIENCE_FILE"
  fi
}

market_healthy() {
  curl --fail --silent --show-error --max-time 2 "$MARKET_URL/health" >/dev/null 2>&1
}

start_collector() {
  COLLECTOR_BINARY="$(resolve_collector_binary || true)"
  if [[ -z "$COLLECTOR_BINARY" || ! -f "$COLLECTOR_BINARY" ]]; then
    return 0
  fi
  if [[ -z "${UPSTOX_ACCESS_TOKEN:-}" ]]; then
    return 0
  fi

  if collector_running; then
    if collector_binary_current; then
      return 0
    fi
    stop_collector >/dev/null || true
  fi

  if [[ ! -x "$COLLECTOR_BINARY" ]]; then
    chmod 0750 "$COLLECTOR_BINARY" || return 2
  fi

  nohup "$COLLECTOR_BINARY" >>"$COLLECTOR_LOG_FILE" 2>&1 </dev/null &
  collector_pid=$!
  printf '%s\n' "$collector_pid" > "$COLLECTOR_PID_FILE"

  sleep 1
  if ! kill -0 "$collector_pid" 2>/dev/null; then
    rm -f "$COLLECTOR_PID_FILE"
    echo "QNext Data Collector exited during startup" >>"$COLLECTOR_LOG_FILE"
    return 4
  fi
  return 0
}

start_service() {
  BINARY="$(resolve_binary || true)"
  load_runtime_environment

  if is_running; then
    if ! runtime_binary_current; then
      echo "QNext Market Core binary changed after deployment; restarting runtime" >>"$LOG_FILE"
      stop_service >/dev/null || true
    elif market_healthy; then
      if ! start_collector; then
        echo "QNext Data Collector is unavailable; Market Core remains active" >>"$COLLECTOR_LOG_FILE"
      fi
      echo "active"
      return 0
    else
      echo "QNext Market Core process exists but is not serving $MARKET_URL; replacing stale runtime" >>"$LOG_FILE"
      stop_service >/dev/null || true
    fi
  fi

  if [[ -z "$BINARY" || ! -f "$BINARY" ]]; then
    echo "QNext Market Core binary is missing: $BINARY" >&2
    return 2
  fi
  if [[ ! -x "$BINARY" ]]; then
    chmod 0750 "$BINARY" || {
      echo "QNext Market Core binary is not executable: $BINARY" >&2
      return 2
    }
  fi

  nohup "$BINARY" >>"$LOG_FILE" 2>&1 </dev/null &
  pid=$!
  printf '%s\n' "$pid" > "$PID_FILE"

  sleep 1
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PID_FILE"
    echo "QNext Market Core exited during startup" >&2
    if [[ -s "$LOG_FILE" ]]; then
      tail -n 20 "$LOG_FILE" >&2 || true
    fi
    return 4
  fi

  if ! start_collector; then
    echo "QNext Data Collector is unavailable; Market Core remains active" >>"$COLLECTOR_LOG_FILE"
  fi
  prune_old_binaries
  echo "active"
}

prune_old_binaries() {
  local candidate
  for candidate in "$PAYLOAD_PRIVATE"/bin/qnext-market-core-*; do
    [[ -e "$candidate" ]] || continue
    [[ "$candidate" == "$BINARY" ]] && continue
    rm -f "$candidate" 2>/dev/null || true
  done
  for candidate in "$PAYLOAD_PRIVATE"/bin/qnext-data-collector-*; do
    [[ -e "$candidate" ]] || continue
    [[ "$candidate" == "$COLLECTOR_BINARY" ]] && continue
    rm -f "$candidate" 2>/dev/null || true
  done
}

stop_collector() {
  if ! collector_running; then
    rm -f "$COLLECTOR_PID_FILE"
    return 0
  fi

  collector_pid="$(read_collector_pid)"
  kill -TERM "$collector_pid" 2>/dev/null || true
  for _ in {1..30}; do
    if ! kill -0 "$collector_pid" 2>/dev/null; then
      rm -f "$COLLECTOR_PID_FILE"
      return 0
    fi
    sleep 0.2
  done
  kill -KILL "$collector_pid" 2>/dev/null || true
  rm -f "$COLLECTOR_PID_FILE"
}

stop_service() {
  stop_collector >/dev/null || true

  if ! is_running; then
    rm -f "$PID_FILE"
    echo "stopped"
    return 0
  fi

  pid="$(read_pid)"
  kill -TERM "$pid" 2>/dev/null || true

  for _ in {1..30}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      echo "stopped"
      return 0
    fi
    sleep 0.2
  done

  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  echo "stopped"
}

smoke() {
  curl --fail --silent --show-error --max-time 3 "$MARKET_URL/health" >/dev/null
  curl --fail --silent --show-error --max-time 3 "$MARKET_URL/ready" >/dev/null
  curl --fail --silent --show-error --max-time 3 "$MARKET_URL/version" >/dev/null
  echo "smoke PASS"
}

set_desired() {
  local state="$1"
  printf '%s\n' "$state" > "$DESIRED_STATE"
}

process_intelligence_request() {
  [[ -s "$INTELLIGENCE_REQUEST" ]] || return 0

  local intelligence_root="$PAYLOAD_PRIVATE/intelligence"
  if [[ ! -d "$intelligence_root/qnext_intelligence" ]]; then
    printf '%s\n' '{"state":"FAILED","action":"unknown","request_id":"","completed_at_ms":0,"error":"Quant Intelligence runtime is not deployed"}' > "$INTELLIGENCE_RESULT"
    rm -f "$INTELLIGENCE_REQUEST"
    return 0
  fi

  if ! PYTHONPATH="$intelligence_root" python3 -m qnext_intelligence.admin_worker \
      --request "$INTELLIGENCE_REQUEST" \
      --result "$INTELLIGENCE_RESULT" \
      --storage-root "$PRIVATE_ROOT/storage/intelligence" >>"$INTELLIGENCE_LOG" 2>&1; then
    echo "Quant Intelligence queued action failed; see $INTELLIGENCE_LOG" >>"$INTELLIGENCE_LOG"
  fi
  rm -f "$INTELLIGENCE_REQUEST"
}

process_intelligence_lab_request() {
  [[ -s "$INTELLIGENCE_LAB_REQUEST" ]] || return 0

  local intelligence_root="$PAYLOAD_PRIVATE/intelligence"
  local lab_python="python3"
  local isolated_python=""
  local lab_action=""

  if [[ ! -d "$intelligence_root/qnext_intelligence" ]]; then
    printf '%s\n' '{"state":"FAILED","action":"unknown","request_id":"","completed_at_ms":0,"error":"Intelligence Lab runtime is not deployed"}' > "$INTELLIGENCE_LAB_RESULT"
    rm -f "$INTELLIGENCE_LAB_REQUEST"
    return 0
  fi

  lab_action="$(python3 - "$INTELLIGENCE_LAB_REQUEST" <<'PY' 2>/dev/null || true
import json
import sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        value = json.load(handle)
    print(str(value.get("action", "")))
except Exception:
    pass
PY
)"

  if [[ ( "$lab_action" == "backtest" || "$lab_action" == "shadow-observation" ) && -x "$INTELLIGENCE_LAB_PYTHON_HELPER" ]]; then
    if isolated_python="$(QNEXT_PRIVATE_ROOT="$PRIVATE_ROOT" "$INTELLIGENCE_LAB_PYTHON_HELPER" bootstrap 2>>"$INTELLIGENCE_LAB_LOG")" \
        && [[ -x "$isolated_python" ]]; then
      lab_python="$isolated_python"
      echo "Intelligence Lab using isolated ML runtime: $lab_python" >>"$INTELLIGENCE_LAB_LOG"
    else
      echo "Intelligence Lab ML runtime unavailable; using Ridge-safe system Python fallback" >>"$INTELLIGENCE_LAB_LOG"
    fi
  fi

  if ! PYTHONPATH="$intelligence_root" "$lab_python" -m qnext_intelligence.lab_worker \
      --request "$INTELLIGENCE_LAB_REQUEST" \
      --result "$INTELLIGENCE_LAB_RESULT" \
      --storage-root "$PRIVATE_ROOT/storage/intelligence-lab" \
      --production-root "$PRIVATE_ROOT/storage/intelligence" \
      --market-core-url "$MARKET_URL" >>"$INTELLIGENCE_LAB_LOG" 2>&1; then
    echo "Intelligence Lab queued action failed; see $INTELLIGENCE_LAB_LOG" >>"$INTELLIGENCE_LAB_LOG"
  fi
  rm -f "$INTELLIGENCE_LAB_REQUEST"
}

process_intelligence_lab_shadow_inbox() {
  [[ -d "$INTELLIGENCE_LAB_SHADOW_INBOX" ]] || return 0

  local intelligence_root="$PAYLOAD_PRIVATE/intelligence"
  local lab_python="python3"
  local isolated_python=""
  local request_path=""
  local processed=0

  if [[ ! -d "$intelligence_root/qnext_intelligence" ]]; then
    return 0
  fi

  if [[ -x "$INTELLIGENCE_LAB_PYTHON_HELPER" ]]; then
    if isolated_python="$(QNEXT_PRIVATE_ROOT="$PRIVATE_ROOT" "$INTELLIGENCE_LAB_PYTHON_HELPER" bootstrap 2>>"$INTELLIGENCE_LAB_LOG")" \
        && [[ -x "$isolated_python" ]]; then
      lab_python="$isolated_python"
    else
      echo "Shadow-Live ML runtime unavailable; using Ridge-safe system Python fallback" >>"$INTELLIGENCE_LAB_LOG"
    fi
  fi

  while IFS= read -r request_path; do
    [[ -n "$request_path" ]] || continue
    if PYTHONPATH="$intelligence_root" "$lab_python" -m qnext_intelligence.lab_worker \
        --request "$request_path" \
        --result "$INTELLIGENCE_LAB_SHADOW_RESULT" \
        --storage-root "$PRIVATE_ROOT/storage/intelligence-lab" \
        --production-root "$PRIVATE_ROOT/storage/intelligence" \
        --market-core-url "$MARKET_URL" >>"$INTELLIGENCE_LAB_LOG" 2>&1; then
      rm -f "$request_path"
    else
      echo "Shadow-Live observation failed and will retry: $request_path" >>"$INTELLIGENCE_LAB_LOG"
    fi

    processed=$((processed + 1))
    if (( processed >= 50 )); then
      break
    fi
  done < <(find "$INTELLIGENCE_LAB_SHADOW_INBOX" -maxdepth 1 -type f -name '*.json' -print 2>/dev/null | sort)
}

reconcile() {
  date +%s > "$CRON_HEARTBEAT"
  process_intelligence_request
  process_intelligence_lab_request
  process_intelligence_lab_shadow_inbox

  local request=""
  if [[ -s "$CONTROL_REQUEST" ]]; then
    request="$(tr -d '\r\n' < "$CONTROL_REQUEST")"
    rm -f "$CONTROL_REQUEST"

    case "$request" in
      start)
        set_desired "running"
        start_service
        return
        ;;
      stop)
        set_desired "stopped"
        stop_service
        return
        ;;
      restart)
        set_desired "running"
        stop_service >/dev/null || true
        start_service
        return
        ;;
      *)
        echo "ignoring invalid QNext control request: $request" >&2
        ;;
    esac
  fi

  desired="$(tr -d '\r\n' < "$DESIRED_STATE" 2>/dev/null || true)"
  case "$desired" in
    running)
      start_service
      ;;
    stopped|"")
      stop_service
      ;;
    *)
      echo "invalid desired state: $desired" >&2
      set_desired "stopped"
      stop_service
      ;;
  esac
}

action="${1:-}"
case "$action" in
  status)
    status
    ;;
  research-status)
    research_status
    ;;
  start)
    acquire_lock
    set_desired "running"
    start_service
    ;;
  stop)
    acquire_lock
    set_desired "stopped"
    stop_service
    ;;
  restart)
    acquire_lock
    set_desired "running"
    stop_service >/dev/null
    start_service
    ;;
  reconcile)
    acquire_lock
    reconcile
    ;;
  smoke)
    smoke
    ;;
  activate|rollback)
    echo "release activation is managed by the DigiOps direct deployment on this host" >&2
    exit 3
    ;;
  *)
    echo "unsupported action" >&2
    exit 2
    ;;
esac
