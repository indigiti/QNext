#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -z "${QNEXT_PRIVATE_ROOT:-}" ]]; then
  if [[ -f "$SCRIPT_DIR/../bin/qnext-market-core" ]]; then
    QNEXT_PRIVATE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
  else
    QNEXT_PRIVATE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
  fi
fi

PRIVATE_ROOT="${QNEXT_PRIVATE_ROOT%/}"
CURRENT_PRIVATE=""

if [[ -L "$PRIVATE_ROOT/current" ]]; then
  current_target="$(readlink -f "$PRIVATE_ROOT/current" 2>/dev/null || true)"
  if [[ -n "$current_target" && -d "$current_target/private" ]]; then
    CURRENT_PRIVATE="$current_target/private"
  fi
fi

PAYLOAD_PRIVATE="$PRIVATE_ROOT"
if [[ -n "$CURRENT_PRIVATE" ]]; then
  PAYLOAD_PRIVATE="$CURRENT_PRIVATE"
elif [[ -f "$PRIVATE_ROOT/private/bin/qnext-market-core" ]]; then
  PAYLOAD_PRIVATE="$PRIVATE_ROOT/private"
fi
BINARY="$PAYLOAD_PRIVATE/bin/qnext-market-core"
PID_FILE="$PRIVATE_ROOT/run/market-core.pid"
LOG_FILE="$PRIVATE_ROOT/logs/market-core.log"
CONFIG_FILE="$PRIVATE_ROOT/config/q1-market.json"
RESILIENCE_FILE="$PRIVATE_ROOT/config/q3-resilience.json"
SECRETS_FILE="$PRIVATE_ROOT/secrets/qnext.env"
CONTROL_REQUEST="$PRIVATE_ROOT/run/control-request"
DESIRED_STATE="$PRIVATE_ROOT/run/desired-state"
CRON_HEARTBEAT="$PRIVATE_ROOT/run/cron-heartbeat"
LOCK_DIR="$PRIVATE_ROOT/run/supervisor.lock"
MARKET_URL="${QNEXT_MARKET_CORE_URL:-http://127.0.0.1:18080}"

mkdir -p "$PRIVATE_ROOT/run" "$PRIVATE_ROOT/logs" "$PRIVATE_ROOT/storage" "$PRIVATE_ROOT/config" "$PRIVATE_ROOT/secrets"

if [[ ! -s "$DESIRED_STATE" ]]; then
  printf 'stopped\n' > "$DESIRED_STATE"
fi

read_pid() {
  if [[ -s "$PID_FILE" ]]; then
    cat "$PID_FILE"
  fi
}

find_existing_pid() {
  local proc pid cmdline
  for proc in /proc/[0-9]*; do
    [[ -r "$proc/cmdline" ]] || continue
    pid="${proc##*/}"
    [[ "$pid" != "$" ]] || continue
    cmdline="$(tr '\0' ' ' < "$proc/cmdline" 2>/dev/null || true)"
    case "$cmdline" in
      "$BINARY"|"$BINARY "*)
        printf '%s\n' "$pid"
        return 0
        ;;
    esac
  done
  return 1
}

is_running() {
  local pid
  pid="$(read_pid || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    return 0
  fi

  rm -f "$PID_FILE"
  pid="$(find_existing_pid || true)"
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    printf '%s\n' "$pid" > "$PID_FILE"
    return 0
  fi

  return 1
}

runtime_binary_current() {
  local pid running_identity deployed_identity
  pid="$(read_pid || true)"
  [[ -n "$pid" ]] || return 1
  [[ -e "/proc/$pid/exe" ]] || return 1
  [[ -f "$BINARY" ]] || return 1

  running_identity="$(stat -Lc '%d:%i' "/proc/$pid/exe" 2>/dev/null || true)"
  deployed_identity="$(stat -Lc '%d:%i' "$BINARY" 2>/dev/null || true)"
  [[ -n "$running_identity" && "$running_identity" == "$deployed_identity" ]]
}

acquire_lock() {
  local owner attempts=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    owner=""
    if [[ -s "$LOCK_DIR/pid" ]]; then
      owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    fi

    if [[ -z "$owner" ]] || ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      continue
    fi

    attempts=$((attempts + 1))
    if (( attempts >= 50 )); then
      echo "QNext supervisor is busy" >&2
      return 5
    fi
    sleep 0.1
  done

  printf '%s\n' "$" > "$LOCK_DIR/pid"
  trap 'rm -rf "$LOCK_DIR" 2>/dev/null || true' EXIT INT TERM
}

status() {
  if is_running; then
    echo "active"
    return 0
  fi
  rm -f "$PID_FILE"
  echo "stopped"
  return 0
}

load_runtime_environment() {
  export QNEXT_HTTP_ADDR="127.0.0.1:18080"
  export QNEXT_STORAGE_ROOT="$PRIVATE_ROOT/storage"
  export QNEXT_RAW_CAPTURE="1"

  if [[ -r "$SECRETS_FILE" ]]; then
    set -a
    # shellcheck disable=SC1090
    source "$SECRETS_FILE"
    set +a
  fi

  unset QNEXT_MARKET_CONFIG QNEXT_RESILIENCE_CONFIG

  if [[ -s "$CONFIG_FILE" && -n "${UPSTOX_ACCESS_TOKEN:-}" ]]; then
    export QNEXT_MARKET_CONFIG="$CONFIG_FILE"
  fi

  if [[ -s "$RESILIENCE_FILE" && -n "${DHAN_CLIENT_ID:-}" && -n "${DHAN_ACCESS_TOKEN:-}" && -n "${QNEXT_MARKET_CONFIG:-}" ]]; then
    export QNEXT_RESILIENCE_CONFIG="$RESILIENCE_FILE"
  fi
}

market_healthy() {
  curl --fail --silent --show-error --max-time 2 "$MARKET_URL/health" >/dev/null 2>&1
}

start_service() {
  if is_running; then
    if ! runtime_binary_current; then
      echo "QNext Market Core binary changed after deployment; restarting runtime" >>"$LOG_FILE"
      stop_service >/dev/null || true
    elif market_healthy; then
      echo "active"
      return 0
    else
      echo "QNext Market Core process exists but is not serving $MARKET_URL; replacing stale runtime" >>"$LOG_FILE"
      stop_service >/dev/null || true
    fi
  fi

  if [[ ! -f "$BINARY" ]]; then
    echo "QNext Market Core binary is missing: $BINARY" >&2
    return 2
  fi
  if [[ ! -x "$BINARY" ]]; then
    chmod 0750 "$BINARY" || {
      echo "QNext Market Core binary is not executable: $BINARY" >&2
      return 2
    }
  fi

  load_runtime_environment

  nohup "$BINARY" >>"$LOG_FILE" 2>&1 </dev/null &
  pid=$!
  printf '%s\n' "$pid" > "$PID_FILE"

  sleep 1
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PID_FILE"
    echo "QNext Market Core exited during startup" >&2
    if [[ -s "$LOG_FILE" ]]; then
      tail -n 20 "$LOG_FILE" >&2 || true
    fi
    return 4
  fi

  echo "active"
}

stop_service() {
  if ! is_running; then
    rm -f "$PID_FILE"
    echo "stopped"
    return 0
  fi

  pid="$(read_pid)"
  kill -TERM "$pid" 2>/dev/null || true

  for _ in {1..30}; do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      echo "stopped"
      return 0
    fi
    sleep 0.2
  done

  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PID_FILE"
  echo "stopped"
}

smoke() {
  curl --fail --silent --show-error --max-time 3 "$MARKET_URL/health" >/dev/null
  curl --fail --silent --show-error --max-time 3 "$MARKET_URL/ready" >/dev/null
  curl --fail --silent --show-error --max-time 3 "$MARKET_URL/version" >/dev/null
  echo "smoke PASS"
}

set_desired() {
  local state="$1"
  printf '%s\n' "$state" > "$DESIRED_STATE"
}

reconcile() {
  date +%s > "$CRON_HEARTBEAT"

  local request=""
  if [[ -s "$CONTROL_REQUEST" ]]; then
    request="$(tr -d '\r\n' < "$CONTROL_REQUEST")"
    rm -f "$CONTROL_REQUEST"

    case "$request" in
      start)
        set_desired "running"
        start_service
        return
        ;;
      stop)
        set_desired "stopped"
        stop_service
        return
        ;;
      restart)
        set_desired "running"
        stop_service >/dev/null || true
        start_service
        return
        ;;
      *)
        echo "ignoring invalid QNext control request: $request" >&2
        ;;
    esac
  fi

  desired="$(tr -d '\r\n' < "$DESIRED_STATE" 2>/dev/null || true)"
  case "$desired" in
    running)
      start_service
      ;;
    stopped|"")
      stop_service
      ;;
    *)
      echo "invalid desired state: $desired" >&2
      set_desired "stopped"
      stop_service
      ;;
  esac
}

action="${1:-}"
case "$action" in
  status)
    status
    ;;
  start)
    acquire_lock
    set_desired "running"
    start_service
    ;;
  stop)
    acquire_lock
    set_desired "stopped"
    stop_service
    ;;
  restart)
    acquire_lock
    set_desired "running"
    stop_service >/dev/null
    start_service
    ;;
  reconcile)
    acquire_lock
    reconcile
    ;;
  smoke)
    smoke
    ;;
  activate|rollback)
    echo "release activation is managed by the DigiOps direct deployment on this host" >&2
    exit 3
    ;;
  *)
    echo "unsupported action" >&2
    exit 2
    ;;
esac
